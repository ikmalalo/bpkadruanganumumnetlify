# SECURITY: Disable directory browsing
Options -Indexes

# SECURITY: Block access to sensitive files
<FilesMatch "\.(sql|log|ini|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# SECURITY: Block access to hidden files (dotfiles)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# SPA ROUTING: Ensure React Router works correctly
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

